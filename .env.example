# URL base de Odoo (sin barra final)
ODOO_URL=https://juanmoreno.surftpv.app
ODOO_DB=juanmoreno
# API key del usuario "Claude MCP" (caduca a los 3 meses como máximo)
ODOO_API_KEY=
# Fecha de caducidad de esa key (YYYY-MM-DD); odoo_whoami avisa 15 días antes
ODOO_API_KEY_EXPIRES=
# json2 (Odoo 19, recomendado) | jsonrpc (legado; necesita ODOO_LOGIN)
ODOO_API_FLAVOR=json2
ODOO_LOGIN=

# Token que Claude envía en "Authorization: Bearer ..." (openssl rand -hex 32)
MCP_BEARER_TOKEN=

# Contraseña de la página de acceso OAuth (la pide Claude al añadir el conector). Mínimo 10 caracteres.
# Vacía = solo funciona el token fijo (Claude Code). Cambiarla desconecta todos los conectores.
OAUTH_PASSWORD=

# Puerto y hosts permitidos (el dominio público del servidor, separados por coma)
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: id de la categoría de producto de los vinos (product.category)
WINE_CATEGORY_ID=

# Opcional: ubicación interna para ajustes de inventario (stock.location). Por defecto, la del primer almacén.
STOCK_LOCATION_ID=

# Registro de auditoría de escrituras (en Easypanel monta un volumen en /data)
AUDIT_LOG_PATH=./data/audit.jsonl

# Categorías del TPV que cuentan como vino (con subcategorías). 95 = BEBIDAS/VINO, 90 = ROSADO
WINE_POS_CATEGORY_IDS=95,90

# Sistema de reservas (herramientas reservas_*): dirección y el mismo RESERVAS_API_TOKEN que tenga allí
RESERVAS_URL=
RESERVAS_API_TOKEN=
